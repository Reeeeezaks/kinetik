+class TextureNode;
+
+// Kinetik fix: the render thread keeps the redraw / first-frame callbacks after the
+// scene-graph node is destroyed (wallpaper reload, screen rotation/hotplug), and used to
+// call into the deleted node -> plasmashell crash in QObject signal activation.
+// Callbacks now go through this guard; the node detaches itself under the lock first thing
+// in its destructor, so a late callback becomes a no-op.
+struct NodeGuard {
+    std::mutex   mutex;
+    TextureNode* node { nullptr };
+};
+
 class TextureNode : public QObject, public QSGSimpleTextureNode {
